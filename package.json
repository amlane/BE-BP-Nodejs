{
  "name": "single-sized-bytes-api",
  "version": "1.0.0",
  "description": "Node.js/Express boilerplate with JWT authentication over a Knex + SQLite database",
  "main": "index.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "server": "nodemon",
    "start": "node index.js",
    "migrate": "knex migrate:latest",
    "rollback": "knex migrate:rollback",
    "seed": "knex seed:run",
    "test": "vitest run"
  },
  "keywords": [
    "express",
    "jwt",
    "knex",
    "sqlite",
    "boilerplate"
  ],
  "author": "Amanda Lane",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "better-sqlite3": "^12.4.1",
    "cors": "^2.8.5",
    "dotenv": "^17.2.2",
    "express": "^4.21.2",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "knex": "^3.1.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.10",
    "supertest": "^7.1.4",
    "vitest": "^3.2.4"
  },
  "overrides": {
    "body-parser": "^1.20.6",
    "qs": "^6.16.0"
  }
}
